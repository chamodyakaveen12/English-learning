import { createFileRoute } from '@tanstack/react-router';
import { useState, useEffect } from 'react';
import { query } from '@/lib/db';

export const Route = createFileRoute('/test-db')({
  component: TestDbPage,
});

function TestDbPage() {
  const [status, setStatus] = useState<'loading' | 'success' | 'error'>('loading');
  const [message, setMessage] = useState('');
  const [tables, setTables] = useState<string[]>([]);

  useEffect(() => {
    const testConnection = async () => {
      try {
        // Test by getting all table names
        const result = await query(`
          SELECT name FROM sqlite_master 
          WHERE type='table' 
          ORDER BY name
        `);
        
        const tableNames = result.map((row: any) => row.name);
        setTables(tableNames);
        setStatus('success');
        setMessage(`✅ Connected! Found ${tableNames.length} tables in database.`);
      } catch (err) {
        setStatus('error');
        setMessage(`❌ Error: ${err instanceof Error ? err.message : 'Unknown error'}`);
      }
    };
    testConnection();
  }, []);

  return (
    <div className="min-h-screen flex items-center justify-center bg-background px-4">
      <div className="max-w-2xl w-full">
        <h1 className="text-2xl font-display mb-4 text-center">Database Test</h1>
        
        <div className={`p-4 rounded-lg mb-4 ${
          status === 'loading' ? 'bg-secondary/20' : 
          status === 'success' ? 'bg-green-500/10 text-green-600' : 
          'bg-red-500/10 text-red-600'
        }`}>
          {status === 'loading' ? '⏳ Connecting to Turso...' : message}
        </div>

        {status === 'success' && tables.length > 0 && (
          <div className="bg-secondary/10 rounded-lg p-4">
            <h2 className="font-semibold mb-2">📊 Tables Found:</h2>
            <ul className="space-y-1">
              {tables.map((table) => (
                <li key={table} className="text-sm flex items-center gap-2">
                  <span className="text-green-500">✅</span>
                  <code className="bg-secondary/20 px-2 py-0.5 rounded">{table}</code>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  );
}